# Postgres connection (matches docker-compose service defaults)
DATABASE_URL=postgresql+asyncpg://ingestion:ingestion@db:5432/ingestion

# Used by configs/sources/github_issues.yaml via ${GITHUB_TOKEN} substitution.
# A plain scopeless personal access token is enough for public read-only endpoints.
GITHUB_TOKEN=

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
